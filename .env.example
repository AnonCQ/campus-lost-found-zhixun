# ==============================================================================
# 智寻校园 · 智能失物招领与图像匹配系统（FastAPI + SQLite/MySQL + YOLO26n + OpenCLIP）
# ==============================================================================

# 1. 数据库配置：默认使用本地 SQLite（零配置）；如需切换 MySQL，取消下一行注释并填写连接串
# DATABASE_URL="mysql+pymysql://root:123456@127.0.0.1:3306/campus_lost_found?charset=utf8mb4"

# 2. 深度学习视觉模型配置（支持 CUDA GPU 自动加速）
LOCAL_YOLO_WEIGHTS_PATH="backend/models/yolo26n.pt"
YOLO_CONF_THRESHOLD="0.25"
OPENCLIP_MODEL_NAME="ViT-B-32"
OPENCLIP_PRETRAINED="openai"

# 3. 大模型对话 Agent 与 RAG 配置（支持 Google Gemini 原生协议或 OpenAI 兼容接口）
GEMINI_API_KEY=""
GEMINI_EXPLAIN_MODEL="gemini-3.5-flash"
# 如需改用 DeepSeek / 通义千问 / 硅基流动 / Ollama 等 OpenAI 兼容 API，填写以下三项即可自动优先启用：
# LLM_API_KEY=""
# LLM_BASE_URL="https://api.deepseek.com/v1"
# LLM_MODEL="deepseek-chat"

# 4. 管理员白名单与可选 SMTP 邮箱验证码配置
ADMIN_WHITELIST_EMAIL="shx614519@gmail.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# 5. 网络代理（下载模型权重或调用外部 API 时使用）
HTTP_PROXY="http://127.0.0.1:7890"
HTTPS_PROXY="http://127.0.0.1:7890"
