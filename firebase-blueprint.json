{
  "entities": {
    "User": {
      "title": "User",
      "description": "Campus user profile and role assignment keyed by UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "student"], "maxLength": 32 },
        "phone": { "type": "string", "maxLength": 32 },
        "studentId": { "type": "string", "maxLength": 64 },
        "department": { "type": "string", "maxLength": 128 },
        "className": { "type": "string", "maxLength": 128 },
        "bio": { "type": "string", "maxLength": 300 },
        "birthday": { "type": "string", "maxLength": 32 },
        "avatarUrl": { "type": "string", "maxLength": 1024 },
        "browsedItemIds": { "type": "array", "maxLength": 50 },
        "readNotificationIds": { "type": "array", "maxLength": 200 },
        "darkMode": { "type": "boolean" },
        "pushNotifyEnabled": { "type": "boolean" },
        "walletBalance": { "type": "number" },
        "walletTransactions": { "type": "array", "maxLength": 50 },
        "reviews": { "type": "array", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt"]
    },
    "LostFoundItem": {
      "title": "LostFoundItem",
      "description": "Lost or found item record with AI recognition attributes and Storage path.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["lost", "found"], "maxLength": 16 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "campusCategory": { "type": "string", "maxLength": 64 },
        "rawModelClass": { "type": "string", "maxLength": 128 },
        "manualCategoryOverride": { "type": "string", "maxLength": 64 },
        "color": { "type": "string", "maxLength": 64 },
        "quantity": { "type": "number" },
        "rewardAmount": { "type": "number" },
        "locationArea": { "type": "string", "maxLength": 64 },
        "locationDetail": { "type": "string", "maxLength": 160 },
        "location": { "type": "string", "maxLength": 200 },
        "eventTime": { "type": "string", "maxLength": 64 },
        "conditionText": { "type": "string", "maxLength": 128 },
        "keywords": { "type": "array", "maxLength": 20 },
        "imageUrl": { "type": "string", "maxLength": 1024 },
        "storagePath": { "type": "string", "maxLength": 512 },
        "imageSha256": { "type": "string", "maxLength": 128 },
        "embeddingId": { "type": "string", "maxLength": 256 },
        "recognitionTaskId": { "type": "string", "maxLength": 128 },
        "recognitionStatus": { "type": "string", "enum": ["pending", "running", "succeeded", "failed"], "maxLength": 32 },
        "confidence": { "type": "number" },
        "recognitionSource": { "type": "string", "enum": ["model", "fallback", "seed_demo"], "maxLength": 32 },
        "isFallback": { "type": "boolean" },
        "fallbackReason": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["open", "matching", "claiming", "handover", "returned", "delisted"], "maxLength": 32 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "ownerEmail": { "type": "string", "maxLength": 256 },
        "verificationQuestion": { "type": "string", "maxLength": 300 },
        "verificationAnswerHint": { "type": "string", "maxLength": 300 },
        "isSeededDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "type", "title", "description", "campusCategory", "location", "eventTime", "status", "ownerUid", "createdAt"]
    },
    "ImageEmbedding": {
      "title": "ImageEmbedding",
      "description": "Cached L2-normalized real multimodal image embedding vector (gemini-embedding-2, 3072D) keyed by sha256 and modelVersion.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256 },
        "sha256": { "type": "string", "maxLength": 128 },
        "modelVersion": { "type": "string", "maxLength": 64 },
        "dimension": { "type": "number" },
        "vector": { "type": "array", "maxLength": 4096 },
        "itemId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "sha256", "modelVersion", "dimension", "vector", "createdAt"]
    },
    "RecognitionTask": {
      "title": "RecognitionTask",
      "description": "Asynchronous AI recognition task record with retry and latency telemetry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "itemId": { "type": "string", "maxLength": 128 },
        "idempotencyKey": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "enum": ["pending", "running", "succeeded", "failed"], "maxLength": 32 },
        "retryCount": { "type": "number" },
        "maxRetries": { "type": "number" },
        "modelVersion": { "type": "string", "maxLength": 64 },
        "rawModelClass": { "type": "string", "maxLength": 128 },
        "mappedCampusCategory": { "type": "string", "maxLength": 64 },
        "confidence": { "type": "number" },
        "bbox": { "type": "array", "maxLength": 4 },
        "latencyMs": { "type": "number" },
        "cacheHit": { "type": "boolean" },
        "recognitionSource": { "type": "string", "enum": ["model", "fallback", "seed_demo"], "maxLength": 32 },
        "isFallback": { "type": "boolean" },
        "fallbackReason": { "type": "string", "maxLength": 500 },
        "errorMessage": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "itemId", "idempotencyKey", "status", "retryCount", "modelVersion", "createdAt"]
    },
    "MatchRecord": {
      "title": "MatchRecord",
      "description": "Deterministic lost-found match record with 7D score, vector similarity, and explanations.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "lostItemId": { "type": "string", "maxLength": 128 },
        "foundItemId": { "type": "string", "maxLength": 128 },
        "totalScore": { "type": "number" },
        "ruleScore7D": { "type": "number" },
        "imageSimilarity": { "type": "number" },
        "conflictPenalty": { "type": "number" },
        "recallSources": { "type": "array", "maxLength": 5 },
        "conflictReasons": { "type": "array", "maxLength": 10 },
        "algorithmVersion": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["candidate", "confirmed", "excluded"], "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "lostItemId", "foundItemId", "totalScore", "ruleScore7D", "imageSimilarity", "algorithmVersion", "status", "createdAt"]
    },
    "MatchFeedback": {
      "title": "MatchFeedback",
      "description": "User confirmation, exclusion, or category correction feedback on a match.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "matchId": { "type": "string", "maxLength": 256 },
        "itemId": { "type": "string", "maxLength": 128 },
        "userUid": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "enum": ["confirm", "exclude", "restore", "correct_category"], "maxLength": 64 },
        "reason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "matchId", "userUid", "action", "createdAt"]
    },
    "ClaimRecord": {
      "title": "ClaimRecord",
      "description": "Item claim request, verification answer, admin review status, and 6-digit handover code.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "itemId": { "type": "string", "maxLength": 128 },
        "matchId": { "type": "string", "maxLength": 256 },
        "claimType": { "type": "string", "enum": ["claim_found", "return_lost"], "maxLength": 32 },
        "loserUid": { "type": "string", "maxLength": 128 },
        "finderUid": { "type": "string", "maxLength": 128 },
        "claimantUid": { "type": "string", "maxLength": 128 },
        "claimantName": { "type": "string", "maxLength": 100 },
        "verificationAnswer": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending_review", "approved_handover", "rejected", "completed"], "maxLength": 32 },
        "handoverCode": { "type": "string", "maxLength": 16 },
        "qrPayload": { "type": "string", "maxLength": 512 },
        "reviewedBy": { "type": "string", "maxLength": 256 },
        "bountySettled": { "type": "boolean" },
        "reviewedParticipantUids": { "type": "array", "maxLength": 5 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "itemId", "claimantUid", "claimantName", "verificationAnswer", "status", "handoverCode", "createdAt"]
    },
    "MessageRecord": {
      "title": "MessageRecord",
      "description": "In-site message between lost/found participants or admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "itemId": { "type": "string", "maxLength": 128 },
        "senderUid": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderRole": { "type": "string", "maxLength": 32 },
        "receiverUid": { "type": "string", "maxLength": 128 },
        "content": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "itemId", "senderUid", "senderName", "content", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System and admin operation audit log entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 100 },
        "action": { "type": "string", "maxLength": 128 },
        "targetId": { "type": "string", "maxLength": 256 },
        "detail": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "actorUid", "action", "targetId", "detail", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Campus user profiles and role records."
    },
    "/items/{itemId}": {
      "schema": { "$ref": "#/entities/LostFoundItem" },
      "description": "Lost and found item listings."
    },
    "/image_embeddings/{embeddingId}": {
      "schema": { "$ref": "#/entities/ImageEmbedding" },
      "description": "Cached L2-normalized image feature vectors."
    },
    "/recognition_tasks/{taskId}": {
      "schema": { "$ref": "#/entities/RecognitionTask" },
      "description": "Asynchronous recognition tasks and telemetry."
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/MatchRecord" },
      "description": "Deterministic lost-found item matches and 7D + vector score breakdowns."
    },
    "/match_feedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/MatchFeedback" },
      "description": "User confirmation, exclusion, and category override records."
    },
    "/claims/{claimId}": {
      "schema": { "$ref": "#/entities/ClaimRecord" },
      "description": "Item claim verifications, admin approvals, and 6-digit handover codes."
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/MessageRecord" },
      "description": "In-site messages between lost/found owners and admin."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Audit trail of administrative and matching actions."
    }
  }
}
